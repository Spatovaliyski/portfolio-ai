[Unit]
Description=Portfolio Supabase content runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portfolio-runtime
Group=portfolio-runtime
WorkingDirectory=/var/www/spatovaliyski.com/runtime/current
EnvironmentFile=/etc/portfolio/runtime.env
ExecStart=/var/www/spatovaliyski.com/runtime/node/bin/node dist/server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
